{
  "name": "@researchertizar/cyp-player",
  "version": "0.1.0",
  "description": "Modern, zero-dependency universal custom video player for HTML5 and YouTube with stream link shielding, UI models, and web components.",
  "type": "module",
  "main": "./dist/player.umd.js",
  "module": "./dist/player.es.js",
  "types": "./index.d.ts",
  "style": "./dist/player.css",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/player.es.js",
      "require": "./dist/player.umd.js"
    },
    "./style": "./dist/player.css",
    "./dist/player.css": "./dist/player.css"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "node scripts/build-demo.js",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "keywords": [
    "video-player",
    "html5-video",
    "youtube",
    "custom-player",
    "custom-video-player",
    "cyp-player",
    "vanilla-js",
    "zero-dependency",
    "web-component",
    "accessible",
    "media-player"
  ],
  "author": "researchertizar",
  "license": "MIT",
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
